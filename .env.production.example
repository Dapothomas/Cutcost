# Copy to .env on the server and fill in values.
# Free domain tip: use https://YOUR.SERVER.IP.sslip.io  (no signup)

APP_NAME=Cutcost
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR.SERVER.IP.sslip.io

# Used by Caddy for HTTPS (same host, no https://)
APP_DOMAIN=YOUR.SERVER.IP.sslip.io
ACME_EMAIL=you@example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cutcost
DB_USERNAME=cutcost
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-root-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@cutcost.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (use live keys in production)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_API_VERSION=2026-01-28.clover
STRIPE_WEBHOOK_SECRET=
STRIPE_BYPASS_CHECKOUT=false
STRIPE_PRICE_STARTER=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_STUDIO=
STRIPE_CONNECT_COUNTRY=GB
STRIPE_PLATFORM_FEE_PERCENT=0
