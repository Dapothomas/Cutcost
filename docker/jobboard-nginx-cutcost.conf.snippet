# Paste into /opt/jobboard/nginx.conf inside the http { } block.
# Routes only 88.198.131.114.sslip.io → Cutcost. Jobboard hostnames stay unchanged.

    upstream cutcost_app {
        # cutcost-app must be attached to jobboard_default network
        server cutcost-app-1:8080;
    }

    server {
        listen 80;
        server_name 88.198.131.114.sslip.io;

        client_max_body_size 32M;

        location / {
            proxy_pass http://cutcost_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 30s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;
        }
    }
