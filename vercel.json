{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "installCommand": "composer install --no-dev --optimize-autoloader && npm ci",
    "buildCommand": "npm run build && php artisan config:cache && php artisan route:cache && php artisan view:cache",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.0",
            "includeFiles": "{app,bootstrap,config,database,public,resources,routes,storage,vendor}/**"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*\\.(?:css|js|mjs|map|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|json|txt|xml|webmanifest))",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
